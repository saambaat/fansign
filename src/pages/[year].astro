---
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentCard from '../components/MomentCard.astro';
import { moments, monthKey, monthName } from '../lib/moments';

export function getStaticPaths() {
  const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
  return years.map((year) => ({ params: { year } }));
}

const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
const year = Astro.params.year ?? '';
const yearMoments = moments.filter((moment) => moment.date.startsWith(year));
const months = [...new Set(yearMoments.map((moment) => moment.date.slice(0, 7)))];
const grouped = months.map((month) => ({
  month,
  items: yearMoments.filter((moment) => moment.date.startsWith(month)),
}));
---

<BaseLayout
  title={`${year} · Fansigns`}
  years={years}
  activeYear={year}
  searchMoments={yearMoments}
  months={months}
>
  <h1 class="text-lg font-semibold">{year}</h1>
  <div class="mt-4 space-y-6">
    {
      grouped.map(({ month, items }) => (
        <section class="scroll-mt-24" id={monthKey(month)} data-month-section>
          <h2 class="mb-3 text-sm font-medium text-muted-foreground">{monthName(month)}</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] items-start gap-5">
            {items.map((moment) => <MomentCard moment={moment} />)}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
