---
import YearPage from '../../components/YearPage.astro';
import { asLang } from '../../i18n/utils';
import { moments } from '../../lib/moments';

export function getStaticPaths() {
  const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
  return years.map((year) => ({ params: { year } }));
}

const lang = asLang(Astro.currentLocale);
const year = Astro.params.year ?? '';
---

<YearPage lang={lang} year={year} />
