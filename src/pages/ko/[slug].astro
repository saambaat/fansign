---
import PairingPage from '../../components/PairingPage.astro';
import YearPage from '../../components/YearPage.astro';
import { asLang } from '../../i18n/utils';
import { moments } from '../../lib/moments';
import type { Pairing } from '../../lib/moment-schema';
import { pairingPaths } from '../../lib/pairings';

type SlugProps = { kind: 'year'; year: string } | { kind: 'pairing'; pairing: Pairing };

export function getStaticPaths() {
  const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
  const yearPaths: { params: { slug: string }; props: SlugProps }[] = years.map((year) => ({
    params: { slug: year },
    props: { kind: 'year', year },
  }));
  const pairingSlugPaths: { params: { slug: string }; props: SlugProps }[] = pairingPaths().map(
    ({ params, props }) => ({
      params: { slug: params.pairing },
      props: { kind: 'pairing', pairing: props.pairing },
    }),
  );
  return [...yearPaths, ...pairingSlugPaths];
}

const lang = asLang(Astro.currentLocale);
const props = Astro.props as SlugProps;
---

{
  props.kind === 'year' ? (
    <YearPage lang={lang} year={props.year} />
  ) : (
    <PairingPage lang={lang} pairing={props.pairing} />
  )
}
