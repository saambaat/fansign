---
import type { Lang } from '../i18n/ui';
import { posterUrl, videoUrl } from '../lib/imgur';
import { headingFor, momentHref, subFor } from '../lib/moment-display';
import type { Moment } from '../lib/moment-schema';

interface Props {
  moment: Moment;
  lang: Lang;
}

const { moment, lang } = Astro.props;
const heading = headingFor(moment, lang);
const sub = subFor(moment, lang);
const href = momentHref(moment, lang);
---

<a
  href={href}
  class="flex flex-col overflow-hidden rounded-xl border bg-card text-card-foreground transition-colors hover:border-foreground/20 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  data-moment-id={moment.id}
  data-date={moment.date}
>
  <div class="relative aspect-square flex-none bg-black" data-media>
    <video
      data-src={videoUrl(moment.id)}
      data-poster={posterUrl(moment.id)}
      data-preview
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={heading}
      class="block h-full w-full cursor-pointer object-contain"></video>
  </div>
  <div class="flex flex-col p-4">
    <h2 class="line-clamp-2 text-base leading-normal font-medium">{heading}</h2>
    {sub && <p class="mt-1 text-sm text-muted-foreground">{sub}</p>}
  </div>
</a>
