---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { moments } from '../lib/moments';
import { monthKey, monthName } from '../lib/months';
import MomentCard from './MomentCard.astro';

interface Props {
  lang: Lang;
  year: string;
}

const { lang, year } = Astro.props;
const t = useTranslations(lang);

const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
const yearMoments = moments.filter((moment) => moment.date.startsWith(year));
const months = [...new Set(yearMoments.map((moment) => moment.date.slice(0, 7)))];
const grouped = months.map((month) => ({
  month,
  items: yearMoments.filter((moment) => moment.date.startsWith(month)),
}));
---

<BaseLayout
  title={`${year} · ${t('site.title')}`}
  lang={lang}
  years={years}
  activeYear={year}
  searchMoments={yearMoments}
  months={months}
>
  <h1 class="text-lg font-semibold">{year}</h1>
  <div class="mt-4 space-y-6">
    {
      grouped.map(({ month, items }) => (
        <section class="scroll-mt-24" id={monthKey(month)} data-month-section>
          <h2 class="mb-3 text-sm font-medium text-muted-foreground">{monthName(month, lang)}</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] items-start gap-5">
            {items.map((moment) => <MomentCard moment={moment} lang={lang} />)}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
