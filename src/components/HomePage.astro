---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { moments } from '../lib/moments';
import { monthName } from '../lib/months';
import MomentCard from './MomentCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const years = [...new Set(moments.map((moment) => moment.date.slice(0, 4)))];
const latest = moments.slice(0, 10);
const grouped = [...new Set(latest.map((moment) => moment.date.slice(0, 4)))].map((year) => {
  const items = latest.filter((moment) => moment.date.startsWith(year));
  const yearMonths = [...new Set(items.map((moment) => moment.date.slice(0, 7)))];
  return {
    year,
    months: yearMonths.map((month) => ({
      month,
      items: items.filter((moment) => moment.date.startsWith(month)),
    })),
  };
});
---

<BaseLayout title={t('site.title')} lang={lang} years={years} searchMoments={latest}>
  {
    grouped.map(({ year, months }) => (
      <section class="scroll-mt-24 [&+&]:mt-10" id={`year-${year}`} data-year-section>
        <h2 class="text-lg font-semibold">{year}</h2>
        <div class="mt-4 space-y-6">
          {months.map(({ month, items }) => (
            <section class="scroll-mt-24" data-month-section>
              <h3 class="mb-3 text-sm font-medium text-muted-foreground">{monthName(month, lang)}</h3>
              <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] items-start gap-5">
                {items.map((moment) => <MomentCard moment={moment} lang={lang} />)}
              </div>
            </section>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
